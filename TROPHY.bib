  keywords = {Astrophysics - Astrophysics of Galaxies,Astrophysics - Instrumentation and Methods for Astrophysics},
  file = {/Users/thomas/Zotero/storage/ZG3MMPWT/Gagliano and Villar - 2023 - A Physics-Informed Variational Autoencoder for Rapid Galaxy Inference and Anomaly Detection.pdf;/Users/thomas/Zotero/storage/4CY25A4Q/2312.html}
