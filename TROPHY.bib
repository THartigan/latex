@misc{li_learning_2020,
  title = {Learning {{Dynamic Routing}} for {{Semantic Segmentation}}},
  author = {Li, Yanwei and Song, Lin and Chen, Yukang and Li, Zeming and Zhang, Xiangyu and Wang, Xingang and Sun, Jian},
  year = {2020},
