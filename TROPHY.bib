  shorttitle = {The {{NASA Ames PAH IR Spectroscopic Database}}},
  author = {Mattioda, A. L. and Hudgins, D. M. and Boersma, C. and Bauschlicher, C. W. and Ricca, A. and Cami, J. and Peeters, E. and De Armas, F. S{\'a}nchez and Saborido, G. Puerta and Allamandola, L. J.},
  year = {2020},
