    \PYG{k}{return} \PYG{n}{mse} \PYG{o}{+} \PYG{n}{kl}\PYG{p}{,} \PYG{n}{mse}\PYG{p}{,} \PYG{n}{kl}

\PYG{c+c1}{\PYGZsh{} The unsupervised ELBO loss function}
