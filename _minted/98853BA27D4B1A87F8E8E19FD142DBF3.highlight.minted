\PYG{c+c1}{\PYGZsh{} The supervised ELBO loss function}
\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{elbo\PYGZus{}unsupervised}\PYG{p}{(}\PYG{n}{x}\PYG{p}{,} \PYG{n}{model}\PYG{p}{,} \PYG{n}{n\PYGZus{}classes}\PYG{o}{=}\PYG{l+m+mi}{4}\PYG{p}{,} \PYG{n}{beta}\PYG{o}{=}\PYG{l+m+mi}{1}\PYG{p}{)}\PYG{p}{:}
    \PYG{n}{logits}\PYG{p}{,} \PYG{n}{q\PYGZus{}y}\PYG{p}{,} \PYG{n}{mu}\PYG{p}{,} \PYG{n}{logvar}\PYG{p}{,} \PYG{n}{hidden} \PYG{o}{=} \PYG{n}{model}\PYG{o}{.}\PYG{n}{infer}\PYG{p}{(}\PYG{n}{x}\PYG{p}{)}
    \PYG{n}{elbo\PYGZus{}y} \PYG{o}{=} \PYG{p}{[}\PYG{p}{]}
