\PYG{c+c1}{\PYGZsh{} Incorporate the Kullback\PYGZhy{}Leibler loss to prevent the divergence of probability distributionss}
\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{kl\PYGZus{}mse\PYGZus{}loss}\PYG{p}{(}\PYG{n}{recon\PYGZus{}x}\PYG{p}{,} \PYG{n}{x}\PYG{p}{,} \PYG{n}{mu}\PYG{p}{,} \PYG{n}{logvar}\PYG{p}{,} \PYG{n}{beta}\PYG{o}{=}\PYG{l+m+mi}{1}\PYG{p}{)}\PYG{p}{:}
    \PYG{n}{mse} \PYG{o}{=} \PYG{n}{nn}\PYG{o}{.}\PYG{n}{functional}\PYG{o}{.}\PYG{n}{mse\PYGZus{}loss}\PYG{p}{(}\PYG{n}{recon\PYGZus{}x}\PYG{p}{,} \PYG{n}{x}\PYG{p}{,} \PYG{n}{reduction}\PYG{o}{=}\PYG{l+s+s1}{\PYGZsq{}}\PYG{l+s+s1}{sum}\PYG{l+s+s1}{\PYGZsq{}}\PYG{p}{)} \PYG{o}{/} \PYG{n}{x}\PYG{o}{.}\PYG{n}{size}\PYG{p}{(}\PYG{l+m+mi}{0}\PYG{p}{)}
