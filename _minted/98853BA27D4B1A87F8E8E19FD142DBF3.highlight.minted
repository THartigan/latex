        \PYG{n}{y\PYGZus{}k} \PYG{o}{=} \PYG{n}{F}\PYG{o}{.}\PYG{n}{one\PYGZus{}hot}\PYG{p}{(}\PYG{n}{torch}\PYG{o}{.}\PYG{n}{full}\PYG{p}{(}\PYG{p}{(}\PYG{n}{x}\PYG{o}{.}\PYG{n}{size}\PYG{p}{(}\PYG{l+m+mi}{0}\PYG{p}{)}\PYG{p}{,}\PYG{p}{)}\PYG{p}{,} \PYG{n}{k}\PYG{p}{,} \PYG{n}{dtype}\PYG{o}{=}\PYG{n}{torch}\PYG{o}{.}\PYG{n}{long}\PYG{p}{,} \PYG{n}{device}\PYG{o}{=}\PYG{n}{x}\PYG{o}{.}\PYG{n}{device}\PYG{p}{)}\PYG{p}{,} \PYG{n}{n\PYGZus{}classes}\PYG{p}{)}\PYG{o}{.}\PYG{n}{float}\PYG{p}{(}\PYG{p}{)}
        \PYG{c+c1}{\PYGZsh{} recompute mu/logvar conditioned on y\PYGZus{}k}
        \PYG{n}{mu\PYGZus{}k}    \PYG{o}{=} \PYG{n}{model}\PYG{o}{.}\PYG{n}{fc\PYGZus{}mu}\PYG{p}{(}\PYG{n}{torch}\PYG{o}{.}\PYG{n}{cat}\PYG{p}{(}\PYG{p}{[}\PYG{n}{hidden}\PYG{p}{,} \PYG{n}{y\PYGZus{}k}\PYG{p}{]}\PYG{p}{,} \PYG{n}{dim}\PYG{o}{=}\PYG{l+m+mi}{1}\PYG{p}{)}\PYG{p}{)}
        \PYG{n}{logvar\PYGZus{}k}\PYG{o}{=} \PYG{n}{model}\PYG{o}{.}\PYG{n}{fc\PYGZus{}logvar}\PYG{p}{(}\PYG{n}{torch}\PYG{o}{.}\PYG{n}{cat}\PYG{p}{(}\PYG{p}{[}\PYG{n}{hidden}\PYG{p}{,} \PYG{n}{y\PYGZus{}k}\PYG{p}{]}\PYG{p}{,} \PYG{n}{dim}\PYG{o}{=}\PYG{l+m+mi}{1}\PYG{p}{)}\PYG{p}{)}
        \PYG{n}{z\PYGZus{}k}     \PYG{o}{=} \PYG{n}{reparameterise}\PYG{p}{(}\PYG{n}{mu\PYGZus{}k}\PYG{p}{,} \PYG{n}{logvar\PYGZus{}k}\PYG{p}{,} \PYG{n}{eps\PYGZus{}scale}\PYG{o}{=}\PYG{n}{model}\PYG{o}{.}\PYG{n}{eps\PYGZus{}scale}\PYG{p}{)}
        \PYG{c+c1}{\PYGZsh{} reconstruction term}
        \PYG{n}{x\PYGZus{}rec\PYGZus{}k} \PYG{o}{=} \PYG{n}{model}\PYG{o}{.}\PYG{n}{decoder}\PYG{p}{(}\PYG{n}{torch}\PYG{o}{.}\PYG{n}{cat}\PYG{p}{(}\PYG{p}{[}\PYG{n}{z\PYGZus{}k}\PYG{p}{,} \PYG{n}{y\PYGZus{}k}\PYG{p}{]}\PYG{p}{,} \PYG{n}{dim}\PYG{o}{=}\PYG{l+m+mi}{1}\PYG{p}{)}\PYG{p}{)}
        \PYG{n}{mse\PYGZus{}k} \PYG{o}{=} \PYG{o}{\PYGZhy{}}\PYG{n}{F}\PYG{o}{.}\PYG{n}{mse\PYGZus{}loss}\PYG{p}{(}\PYG{n}{x\PYGZus{}rec\PYGZus{}k}\PYG{p}{,} \PYG{n}{x}\PYG{p}{,} \PYG{n}{reduction}\PYG{o}{=}\PYG{l+s+s1}{\PYGZsq{}}\PYG{l+s+s1}{none}\PYG{l+s+s1}{\PYGZsq{}}\PYG{p}{)}\PYG{o}{.}\PYG{n}{sum}\PYG{p}{(}\PYG{n}{dim}\PYG{o}{=}\PYG{l+m+mi}{1}\PYG{p}{)}
        \PYG{c+c1}{\PYGZsh{} KL term}
        \PYG{n}{kl\PYGZus{}k}    \PYG{o}{=} \PYG{o}{\PYGZhy{}}\PYG{l+m+mf}{0.5} \PYG{o}{*} \PYG{n}{torch}\PYG{o}{.}\PYG{n}{sum}\PYG{p}{(}\PYG{l+m+mi}{1} \PYG{o}{+} \PYG{n}{logvar\PYGZus{}k} \PYG{o}{\PYGZhy{}} \PYG{n}{mu\PYGZus{}k}\PYG{o}{.}\PYG{n}{pow}\PYG{p}{(}\PYG{l+m+mi}{2}\PYG{p}{)} \PYG{o}{\PYGZhy{}} \PYG{n}{logvar\PYGZus{}k}\PYG{o}{.}\PYG{n}{exp}\PYG{p}{(}\PYG{p}{)}\PYG{p}{,} \PYG{n}{dim}\PYG{o}{=}\PYG{l+m+mi}{1}\PYG{p}{)} \PYG{o}{*} \PYG{n}{beta}
        \PYG{n}{elbo\PYGZus{}y}\PYG{o}{.}\PYG{n}{append}\PYG{p}{(}\PYG{n}{mse\PYGZus{}k} \PYG{o}{\PYGZhy{}} \PYG{n}{kl\PYGZus{}k}\PYG{p}{)}
    \PYG{n}{elbo\PYGZus{}tensor} \PYG{o}{=} \PYG{n}{torch}\PYG{o}{.}\PYG{n}{stack}\PYG{p}{(}\PYG{n}{elbo\PYGZus{}y}\PYG{p}{,} \PYG{n}{dim}\PYG{o}{=}\PYG{l+m+mi}{1}\PYG{p}{)}
